# OpenRouter (DeepSeek LLM calls — get key at openrouter.ai)
OPENROUTER_API_KEY=

# OpenAI (DALL-E 3 thumbnails only)
OPENAI_API_KEY=

# Groq (free Whisper transcription — get key at console.groq.com)
GROQ_API_KEY=

# Google (Sheets + Drive + YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SHEETS_ID=

# NexLev
NEXLEV_API_KEY=
# Override if NexLev changes their base URL
NEXLEV_BASE_URL=https://app.nexlev.io/api

# TubeBuddy
TUBEBUDDY_API_KEY=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
ZACH_WHATSAPP_NUMBER=+353XXXXXXXXX

# Buffer (Month 2 - leave blank until then)
BUFFER_ACCESS_TOKEN=

# DeepSeek model via OpenRouter — free tier
LLM_MODEL=deepseek/deepseek-chat:free

# Set to "true" to skip writing to Sheets/Drive/WhatsApp during local testing
DRY_RUN=false

# Simple bearer token Make.com sends to authenticate API calls
API_SECRET_KEY=change-this-to-a-random-secret
